{
  "name": "ai-scheduling-advisor",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "description": "Portfolio extension of the MIT-licensed Hiberius/whatsapp-receptionist project: deterministic, explainable appointment-slot ranking and an auditable scheduling decision ledger on top of its multi-tenant WhatsApp booking platform.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valencijdavid-ui/ai-scheduling-advisor.git"
  },
  "homepage": "https://github.com/valencijdavid-ui/ai-scheduling-advisor#readme",
  "bugs": {
    "url": "https://github.com/valencijdavid-ui/ai-scheduling-advisor/issues"
  },
  "author": {
    "name": "Christian Calabrò",
    "url": "https://github.com/Hiberius"
  },
  "license": "MIT",
  "keywords": [
    "whatsapp",
    "ai",
    "receptionist",
    "chatbot",
    "saas-starter",
    "nextjs",
    "supabase",
    "anthropic",
    "claude",
    "stripe",
    "elevenlabs",
    "google-calendar",
    "gdpr",
    "italy",
    "multi-tenant",
    "open-source",
    "self-hosted",
    "appointments",
    "booking",
    "scheduling",
    "explainable-ranking",
    "deterministic-ranking",
    "audit-trail"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "rm -f tsconfig.tsbuildinfo && tsc --noEmit",
    "lint": "eslint . --max-warnings=60",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "db:lint": "node scripts/check-rls-migration.mjs",
    "security:secrets": "gitleaks detect --source . --verbose",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run db:lint",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.67.0",
    "@elevenlabs/elevenlabs-js": "^2.44.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.87.1",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.35.8",
    "next": "15.5.22",
    "pino": "^10.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "stripe": "^20.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.62.0",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.5.22",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.23",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "ws": "^8.21.1",
    "js-yaml": "^4.3.0",
    "nanoid": "^3.3.18",
    "vite": "^7.1.13"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
