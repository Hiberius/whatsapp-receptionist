# ============================================================
# whatsapp-receptionist — Environment Variables Template
# ============================================================
# Copy this file to .env.local for local development.
# NEVER commit .env, .env.local, .env.production, or any file
# containing real secrets to version control.
#
# Legend:
#   [REQUIRED]  Application will not start without this
#   [OPTIONAL]  Feature-gated or has a safe default
#   [PUBLIC]    Safe to expose to the browser (NEXT_PUBLIC_ prefix)
# ============================================================

# ------------------------------------------------------------
# APP CONFIG
# ------------------------------------------------------------

# [PUBLIC][REQUIRED] Base URL of your deployment (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# [PUBLIC][OPTIONAL] Displayed app name
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Ambrogio.ai"

# [OPTIONAL] App version shown in /api/health (defaults to "0.1.0")
NEXT_PUBLIC_APP_VERSION="0.1.0"

# [OPTIONAL] Set by Vercel automatically; shown in /api/health/deep
# VERCEL_REGION=iad1

# [OPTIONAL] Pino log level: trace | debug | info | warn | error | silent
# Defaults to "info" in production, "silent" in test
LOG_LEVEL="info"

NODE_ENV="development"
APP_ENV="development"

# ------------------------------------------------------------
# DATABASE — Supabase
# Project dashboard: https://supabase.com/dashboard
# Settings → API for URL + keys
# ------------------------------------------------------------

# [PUBLIC][REQUIRED] Project URL (safe in browser; protected by RLS)
NEXT_PUBLIC_SUPABASE_URL="https://YOURPROJECT.supabase.co"

# [PUBLIC][REQUIRED] Anon/public key (safe in browser; protected by RLS policies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# [REQUIRED] Service role key — SERVER ONLY. Bypasses RLS. Never expose to client.
# Found in: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=""

# [OPTIONAL] Direct PostgreSQL URL for Drizzle migrations
# Found in: Supabase Dashboard → Settings → Database → Connection string (Direct)
SUPABASE_DB_URL="postgresql://postgres:[PASSWORD]@db.YOURPROJECT.supabase.co:5432/postgres"

# [OPTIONAL] Name of the Supabase Storage bucket for WhatsApp media
SUPABASE_MEDIA_BUCKET="ambrogio-media"

# ------------------------------------------------------------
# INTERNAL JOB SECURITY
# Used to authenticate cron/scheduler calls to /api/internal/* routes
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------

# [REQUIRED] Secret value sent in the job header
INTERNAL_JOB_SECRET=""

# [OPTIONAL] Header name carrying the secret (default: x-ambrogio-job-secret)
INTERNAL_JOB_HEADER_NAME="x-ambrogio-job-secret"

# [VERCEL] Secret used by Vercel Cron, which calls the job routes with
# `Authorization: Bearer <CRON_SECRET>` and cannot send custom headers.
# On Vercel, set this to the same value as INTERNAL_JOB_SECRET (or leave it
# empty here and set only INTERNAL_JOB_SECRET: the code falls back to it).
CRON_SECRET=""

# ------------------------------------------------------------
# AI — Anthropic Claude
# API keys: https://console.anthropic.com/
# ------------------------------------------------------------

# [REQUIRED] Anthropic API key (starts with sk-ant-)
ANTHROPIC_API_KEY=""

# [REQUIRED] Primary model for complex conversations (e.g. claude-opus-4-5)
# Check https://docs.anthropic.com/en/docs/about-claude/models for current IDs
ANTHROPIC_MODEL_PRIMARY=""

# [REQUIRED] Fast model for intent classification (e.g. claude-haiku-4-5)
ANTHROPIC_MODEL_FAST=""

# [OPTIONAL] Enable AI auto-reply globally (default: false — enable per-tenant in DB)
AMBROGIO_AI_AUTOREPLY_ENABLED="false"

# [OPTIONAL] Minimum STT confidence to attempt auto-reply (0–1, default: 0.55)
# Below this threshold voice messages are escalated to human handoff
AMBROGIO_VOICE_STT_MIN_CONFIDENCE="0.55"

# ------------------------------------------------------------
# AI — OpenAI (embeddings only, optional)
# API keys: https://platform.openai.com/api-keys
# Only required if you use vector-based knowledge base retrieval
# ------------------------------------------------------------

# [OPTIONAL] OpenAI API key for embeddings
OPENAI_API_KEY=""

# [OPTIONAL] Embedding model (default: text-embedding-3-large → 1536 dims)
OPENAI_EMBEDDING_MODEL="text-embedding-3-large"

# ------------------------------------------------------------
# VOICE — ElevenLabs (WhatsApp STT + TTS)
# API keys: https://elevenlabs.io/app/speech-synthesis/api-keys
# ------------------------------------------------------------

# [OPTIONAL] ElevenLabs API key. Required to transcribe WhatsApp voice messages.
ELEVENLABS_API_KEY=""

# [OPTIONAL] Speech-to-text model (default: scribe_v2)
ELEVENLABS_STT_MODEL="scribe_v2"

# [OPTIONAL] Text-to-speech model (default: eleven_flash_v2_5)
ELEVENLABS_TTS_MODEL="eleven_flash_v2_5"

# [OPTIONAL] Default TTS voice ID for the AI receptionist
# Find voice IDs at https://elevenlabs.io/voice-library
ELEVENLABS_DEFAULT_VOICE_ID="JBFqnCBsd6RMkjVDRZzb"

# [OPTIONAL] Enable ElevenLabs request logging (default: false)
ELEVENLABS_ENABLE_LOGGING="false"

# ------------------------------------------------------------
# MESSAGING — WhatsApp Cloud API via 360dialog
# Dashboard: https://hub.360dialog.com/
# ------------------------------------------------------------

# [REQUIRED] 360dialog D360-API-KEY for your WhatsApp Business Account
WHATSAPP_API_KEY=""

# [OPTIONAL] 360dialog API base URL (default: https://waba-v2.360dialog.io)
WHATSAPP_API_URL="https://waba-v2.360dialog.io"

# [OPTIONAL] Max size in bytes for WhatsApp media downloads (default: 26214400 = 25 MB)
WHATSAPP_MEDIA_MAX_BYTES="26214400"

# [REQUIRED] Token for Meta webhook verification handshake (GET /api/webhook/whatsapp)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# [OPTIONAL] Custom header name for 360dialog webhook secret (default: x-ambrogio-webhook-secret)
WHATSAPP_WEBHOOK_HEADER_NAME="x-ambrogio-webhook-secret"

# [REQUIRED] Secret value 360dialog sends in the webhook header
WHATSAPP_WEBHOOK_HEADER_SECRET=""

# [OPTIONAL] Rate limit: max requests per window (default: 120)
WHATSAPP_WEBHOOK_RATE_LIMIT_MAX="120"

# [OPTIONAL] Rate limit window in milliseconds (default: 60000 = 1 minute)
WHATSAPP_WEBHOOK_RATE_LIMIT_WINDOW_MS="60000"

# ------------------------------------------------------------
# MESSAGING — Transactional email via Resend
# API keys: https://resend.com/api-keys
# Without RESEND_API_KEY the mailer falls back to a no-op sender that
# logs each message instead of delivering it (dev-friendly, never throws).
# ------------------------------------------------------------

# [OPTIONAL] Recipient for operational alerts raised by the health watchdog
# (outbox queue stalled, dead-letter jobs). Without it the watchdog still runs
# and logs, but nobody is notified.
OPS_ALERT_EMAIL=""

# [OPTIONAL] Resend API key. Required to actually deliver transactional email.
RESEND_API_KEY=""

# [OPTIONAL] From address for transactional email. The domain must be verified in Resend.
RESEND_FROM_EMAIL="Ambrogio.ai <hello@ambrogio.ai>"

# [OPTIONAL] Resend send endpoint (default: https://api.resend.com/emails)
RESEND_API_URL="https://api.resend.com/emails"

# ------------------------------------------------------------
# CALENDAR — Google OAuth
# Credentials: https://console.cloud.google.com/apis/credentials
# Enable the Google Calendar API for your project
# ------------------------------------------------------------

# [REQUIRED] OAuth 2.0 Client ID (for Calendar integration)
GOOGLE_OAUTH_CLIENT_ID=""

# [REQUIRED] OAuth 2.0 Client Secret
GOOGLE_OAUTH_CLIENT_SECRET=""

# [OPTIONAL] Google OAuth authorization endpoint (default: accounts.google.com)
GOOGLE_OAUTH_AUTH_URL="https://accounts.google.com/o/oauth2/v2/auth"

# [OPTIONAL] Google OAuth token endpoint (default: oauth2.googleapis.com)
GOOGLE_OAUTH_TOKEN_URL="https://oauth2.googleapis.com/token"

# [OPTIONAL] Google OAuth revoke endpoint (default: oauth2.googleapis.com)
GOOGLE_OAUTH_REVOKE_URL="https://oauth2.googleapis.com/revoke"

# [REQUIRED] HMAC secret for signing OAuth state parameter (openssl rand -hex 32)
GOOGLE_OAUTH_STATE_SECRET=""

# [REQUIRED] Full redirect URI registered in Google Cloud Console
# Example: https://yourdomain.com/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/integrations/google-calendar/callback"

# [REQUIRED] AES-256-GCM key for encrypting OAuth credentials in DB (hex, 32 bytes)
# Generate with: openssl rand -hex 32
INTEGRATION_CREDENTIALS_ENCRYPTION_KEY=""

# ------------------------------------------------------------
# BILLING — Stripe
# Dashboard: https://dashboard.stripe.com/
# ------------------------------------------------------------

# [REQUIRED] Stripe secret key (use sk_test_... for dev, sk_live_... for prod)
STRIPE_SECRET_KEY=""

# [REQUIRED] Stripe webhook signing secret
# From: Stripe Dashboard → Developers → Webhooks → endpoint details → Signing secret
WHSEC_STRIPE_WEBHOOK=""
STRIPE_WEBHOOK_SECRET=""

# [PUBLIC][REQUIRED] Stripe publishable key (safe in browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# [REQUIRED] Stripe Price IDs for subscription plans
# Create products + prices in Stripe Dashboard (recurring, monthly, EUR)
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PROFESSIONAL=""

# [OPTIONAL] Redirect URLs for Stripe hosted pages
STRIPE_BILLING_PORTAL_RETURN_URL="http://localhost:3000/dashboard/billing"
STRIPE_CHECKOUT_SUCCESS_URL="http://localhost:3000/dashboard/billing?checkout=success"
STRIPE_CHECKOUT_CANCEL_URL="http://localhost:3000/dashboard/billing?checkout=cancel"

# [OPTIONAL] Rate limit: Stripe billing endpoints (default: 120 per 60s)
STRIPE_BILLING_RATE_LIMIT_MAX="120"
STRIPE_BILLING_RATE_LIMIT_WINDOW_MS="60000"

# ------------------------------------------------------------
# BILLING — Fatture in Cloud (Italian e-invoicing / SDI)
# Dashboard: https://app.fattureincloud.it/
# API docs: https://developers.fattureincloud.it/
# Only required if you issue Italian electronic invoices via SDI
# ------------------------------------------------------------

# [OPTIONAL] Fatture in Cloud API token
FATTUREINCLOUD_API_TOKEN=""
FATTURE_IN_CLOUD_API_TOKEN=""

# [OPTIONAL] Company ID from Fatture in Cloud
FATTUREINCLOUD_COMPANY_ID=""
FATTURE_IN_CLOUD_COMPANY_ID=""

# [OPTIONAL] Fatture in Cloud API base URL (default: https://api-v2.fattureincloud.it)
FATTURE_IN_CLOUD_BASE_URL="https://api-v2.fattureincloud.it"

# ------------------------------------------------------------
# RATE LIMITING — Upstash Redis
# Dashboard: https://console.upstash.com/
# Optional: falls back to in-memory rate limiting if not configured
# ------------------------------------------------------------

# [OPTIONAL] Upstash Redis REST URL
UPSTASH_REDIS_REST_URL=""

# [OPTIONAL] Upstash Redis REST token
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------
# OBSERVABILITY — Sentry (optional)
# Dashboard: https://sentry.io/
# ------------------------------------------------------------

# [OPTIONAL] Sentry DSN for error tracking
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
